# Base de datos
DATABASE_URL=

# App
PORT=3000
NODE_ENV=development

# Auth (familiar, no multiusuario genérico — ver §18 del spec)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGIN=

# Key compartida que pokev_frontend manda en cada request (header
# x-app-key) — protege el backend de acceso anónimo, ver ApiKeyGuard.
# No es login por persona, es una key fija para toda la familia. Generar
# con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_API_KEY=

# Escaneo de cartas por foto (opcional — sin esto, POST /scan/card responde
# con un error amigable, el resto de la API funciona igual). Conseguir una
# key en console.groq.com. GROQ_VISION_MODEL tiene un default razonable;
# confirmá en console.groq.com/docs/models que sigue existiendo antes de
# depender de él en producción, los modelos de Groq rotan seguido.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Storage de fotos de cartas (V0.7 — reemplaza guardar la foto inline como
# data:base64 en cards.image_url, ver design.md de add-scan-and-favorites-widget
# sobre ese riesgo). Cloudflare R2, API S3-compatible.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pokev
R2_PUBLIC_URL=
