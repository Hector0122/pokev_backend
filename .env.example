# Base de datos (Postgres local en desarrollo; Railway u otro host en producción)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pokev?schema=public"

# App
PORT=3000
NODE_ENV=development

# Auth (familiar, no multiusuario genérico — ver §18 del spec)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGIN=
